# Copy to .env (never commit .env)
PORT=4000
DATABASE_URL=postgres://newsportal:change-me@localhost:5432/newsportal
# Used from the auth item onward: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
# Production only: public origin used for canonical + og:url (required when NODE_ENV=production)
PUBLIC_BASE_URL=
