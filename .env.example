# Copy to .env at the repo root (never commit .env). Read by backend/src/config.js `loadConfig`.
# [prod] = required when NODE_ENV=production. Everything else has the default shown.

# development | test | production
NODE_ENV=development
PORT=4000
# [required in every env]
DATABASE_URL=postgres://newsportal:change-me@localhost:5432/newsportal

# [prod] >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=news-portal
JWT_AUDIENCE=news-portal-web
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# Replay of a just-rotated refresh token within this window re-mints instead of revoking (lost response, two tabs). 0 disables.
REFRESH_REUSE_GRACE_SECONDS=30
# Optional first-admin bootstrap (both or neither). Created at boot only while no admin exists; remove after first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Defaults to true in production, false otherwise; must be true in production
COOKIE_SECURE=false
# Only behind a reverse proxy: hop count (e.g. 1) or true. Unset = no proxy trust
TRUST_PROXY=
CORS_ORIGIN=http://localhost:5173
# [prod] public origin (no path) used for canonical + og:url, e.g. https://news.example.com
PUBLIC_BASE_URL=
# Built frontend served by the API; default: <repo>/frontend/dist
FRONTEND_DIST=

# PostgreSQL pool
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
